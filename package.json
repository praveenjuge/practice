{
  "name": "practice",
  "version": "2.1.0",
  "license": "MIT",
  "main": "expo-router/entry",
  "scripts": {
    "android": "JAVA_HOME=${JAVA_HOME:-/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home} ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} expo run:android",
    "build:web": "expo export --platform web --clear",
    "deploy": "bun run build:web && wrangler d1 migrations apply practice --remote && wrangler deploy",
    "dev": "bun run --parallel ios dev:api",
    "dev:api": "wrangler d1 migrations apply practice --local && wrangler dev",
    "dev:auth": "workos-emulate --interactive --seed workos-emulate.config.yaml --redirect-hosts callback",
    "dev:web": "bun run build:web && bun run dev:api",
    "e2e": "maestro test .maestro",
    "e2e:build:android": "expo run:android --variant release --no-bundler",
    "e2e:build:ios": "expo run:ios --configuration Release --no-bundler",
    "ios": "expo run:ios",
    "prepare": "husky",
    "release:android": "scripts/release-android.sh",
    "release:ios": "scripts/release-ios.sh",
    "start": "expo start",
    "test:api": "vitest run --config worker/vitest.config.mts"
  },
  "dependencies": {
    "@expo/material-symbols": "^0.1.1",
    "@expo/ui": "~58.0.27",
    "@hono/zod-validator": "^0.9.1",
    "@workos-inc/node": "^12.2.0",
    "expo": "^58.0.0",
    "expo-app-intents": "~0.5.16",
    "expo-auth-session": "~58.0.17",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "expo-widgets": "~58.0.27",
    "hono": "^4.13.17",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "typescript": "~6.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261109.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@workos/emulate": "^0.19.1",
    "husky": "^9.1.7",
    "jose": "^6.2.16",
    "ultracite": "^8.1.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "packageManager": "bun@1.4.2"
}
