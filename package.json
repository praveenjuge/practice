{
  "name": "practice",
  "version": "1.2.0",
  "license": "MIT",
  "main": "expo-router/entry",
  "scripts": {
    "android": "JAVA_HOME=${JAVA_HOME:-/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home} ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} expo run:android",
    "build:android:internal": "eas build --platform android --profile preview",
    "build:local": "eas build --platform ios --local",
    "build:submit": "eas submit --platform ios",
    "build:web": "expo export --platform web --clear",
    "check": "ultracite check",
    "deploy": "bun run build:web && wrangler d1 migrations apply practice --remote && wrangler deploy",
    "deploy:dry-run": "bun run build:web && wrangler deploy --dry-run",
    "dev": "bun run --parallel ios dev:api",
    "dev:api": "wrangler d1 migrations apply practice --local && wrangler dev",
    "dev:web": "bun run build:web && bun run dev:api",
    "fix": "ultracite fix",
    "ios": "expo run:ios",
    "metadata:pull": "eas metadata:pull",
    "metadata:push": "eas metadata:push",
    "prepare": "husky",
    "serve:web": "expo serve",
    "start": "expo start",
    "test:api": "vitest run --config worker/vitest.config.mts",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/material-symbols": "^0.1.1",
    "@expo/ui": "~58.0.27",
    "@hono/zod-validator": "^0.9.1",
    "@types/react": "^19.3.0",
    "@workos-inc/node": "^12.2.0",
    "expo": "^58.0.0",
    "expo-auth-session": "~58.0.17",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "hono": "^4.13.17",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "typescript": "~6.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261109.1",
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "jose": "^6.2.16",
    "ultracite": "^8.1.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "packageManager": "bun@1.4.2"
}
